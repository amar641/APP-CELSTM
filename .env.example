# Copy to .env and fill in real values. Never commit a real .env file.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

# ---------------------------------------------------------------------------
# PostgreSQL / PostGIS — system of record
# ---------------------------------------------------------------------------
POSTGRES_USER=industrial_fire
POSTGRES_PASSWORD=change_me
POSTGRES_DB=industrial_fire
POSTGRES_PORT=5432
# Full SQLAlchemy URL used by the app; override directly if not using compose defaults.
DATABASE_URL=postgresql+psycopg://industrial_fire:change_me@localhost:5432/industrial_fire

# ---------------------------------------------------------------------------
# Qdrant — embedding index, NOT the system of record
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=satellite_image_embeddings

# ---------------------------------------------------------------------------
# NASA FIRMS
# Get a free key at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# ---------------------------------------------------------------------------
FIRMS_MAP_KEY=your_firms_map_key_here
# Bounding box for area of interest: west,south,east,north (lon/lat)
AOI_BBOX=68.0,20.0,78.0,28.0
# VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT
# Days of history to pull for persistence checks (FIRMS free tier max is 10)
HISTORY_DAYS=7

# ---------------------------------------------------------------------------
# OpenStreetMap / Overpass — industrial facility geometry
# ---------------------------------------------------------------------------
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Weather provider (pluggable — see infrastructure/weather)
# ---------------------------------------------------------------------------
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# ---------------------------------------------------------------------------
# Satellite / STAC source
# ---------------------------------------------------------------------------
STAC_API_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-l2a
SATELLITE_IMAGE_CACHE_DIR=./.cache/satellite

# ---------------------------------------------------------------------------
# ML / CELSTM
# ---------------------------------------------------------------------------
MODEL_REGISTRY_DIR=./.models
MODEL_DEVICE=cpu
